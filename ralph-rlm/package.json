{
  "name": "@alcinanet/ralph-rlm",
  "version": "4.1.0",
  "description": "Ralph-RLM Framework — AI-driven autonomous development orchestrator. Four-phase iterative coding: PRD -> features -> optimize -> implementation. Supports Claude Code and GitHub Copilot.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "ralph": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "prompts/",
    "scaffold-assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('../README.md','README.md')\" && npm test && npm run build",
    "smoke:todo": "node ./scripts/smoke-todo.mjs --mode all",
    "smoke:todo:sequential": "node ./scripts/smoke-todo.mjs --mode sequential",
    "smoke:todo:team": "node ./scripts/smoke-todo.mjs --mode team",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "claude",
    "copilot",
    "autonomous",
    "development",
    "ralph",
    "prd",
    "code-generation",
    "agent",
    "cli"
  ],
  "author": "Waseem",
  "license": "MIT",
  "homepage": "https://github.com/Was85/ralph-rlm-agent-framework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Was85/ralph-rlm-agent-framework.git"
  },
  "bugs": {
    "url": "https://github.com/Was85/ralph-rlm-agent-framework/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "proper-lockfile": "^4.1.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yargs": "^17.0.33",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
